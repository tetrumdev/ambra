{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMBRA",
  "version": "0.1.2",
  "identifier": "com.quantium.ambra",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMBRA",
        "width": 1200,
        "height": 800,
        "minHeight": 600,
        "minWidth": 850,
        "backgroundColor": "#000000",
        "theme": "Dark",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-smooth-scrolling",
        "scrollBarStyle": "fluentOverlay",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http://127.0.0.1:38147",
        "media-src": "'self' asset: http://asset.localhost blob: http://127.0.0.1:38147",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:38147 https:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http://127.0.0.1:38147",
        "media-src": "'self' asset: http://asset.localhost blob: http://127.0.0.1:38147",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://127.0.0.1:38147 https:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$AUDIO/Ambra/**", "$APPCACHE/seekable-flac/**", "$APPCACHE/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/macIcon.png",
      "icons/macIcon.icns",
      "icons/winIcon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
