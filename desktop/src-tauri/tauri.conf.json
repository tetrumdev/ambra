{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMBRA",
  "version": "0.1.0",
  "identifier": "com.quantium.ambra",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMBRA",
        "width": 1200,
        "height": 800,
        "minHeight": 600,
        "minWidth": 850,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$AUDIO/Ambra/**", "$APPCACHE/seekable-flac/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/ambra_icon.icns"]
  }
}
