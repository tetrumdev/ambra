{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMBRA",
  "version": "0.2.1",
  "identifier": "com.quantium.ambra",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMBRA",
        "visible": false,
        "width": 1200,
        "height": 800,
        "minHeight": 600,
        "minWidth": 850,
        "backgroundColor": "#0a0a0a",
        "theme": "Dark",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-smooth-scrolling",
        "scrollBarStyle": "fluentOverlay",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost blob: http:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost blob: http:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http: https:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$AUDIO/Ambra/**", "$APPCACHE/seekable-flac/**", "$APPCACHE/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/macIcon.png",
      "icons/macIcon.icns",
      "icons/winIcon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNUE2MjREMEU2M0ExNjgKUldSb29XTU9UV0phUHk4ZnViZnUzWUdUSmhxd3dhTTF6djQ4b0Z3aGF2aWZ6eEtXbTB4d2lEa24K",
      "endpoints": [
        "https://github.com/tetrumdev/ambra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
